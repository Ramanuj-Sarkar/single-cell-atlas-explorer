// Docker profile: run every process in the scanpy container image.
//
// The analysis scripts are baked into the image at /opt/pipeline (see
// docker/Dockerfile), so inside the container they are always available
// regardless of the host checkout location. The raw input h5ad is passed as a
// channel input, so Nextflow bind-mounts its directory automatically.

params.script        = "/opt/pipeline/analysis/pbmc3k_scanpy.py"
params.obtain_script = "/opt/pipeline/obtain_dataset.py"

docker {
    enabled = true
}

process {
    container = "${params.container}"
}
