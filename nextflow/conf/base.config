// Baseline process configuration (local execution).

process {
    // sensible defaults for the lightweight PBMC3k analysis
    cpus   = 2
    memory = 4.GB
    time   = 1.h

    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'cpu_1' {
        cpus   = 1
        memory = 2.GB
        time   = 30.min
    }
}
