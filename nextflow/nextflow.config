// Global Nextflow configuration for the PBMC3k Scanpy pipeline.
// See https://www.nextflow.io/docs/latest/config.html

params {
    // --- inputs ---------------------------------------------------------
    input  = "data/pbmc3k_raw.h5ad"                    // raw 10x expression matrix
    outdir = "results_nextflow"                        // published results root

    // --- executables ----------------------------------------------------
    script        = "${projectDir}/../analysis/pbmc3k_scanpy.py"
    obtain_script = "${projectDir}/../obtain_dataset.py"
    python        = "python3"
    multiqc       = "multiqc"

    // --- analysis parameters --------------------------------------------
    resolution = 0.8   // Leiden clustering resolution

    // --- MultiQC --------------------------------------------------------
    multiqc_config = "${projectDir}/assets/multiqc_config.yml"

    // --- docker ---------------------------------------------------------
    container = "scanpy-pbmc3k:latest"
}

profiles {
    standard {
        includeConfig "${projectDir}/conf/base.config"
    }
    docker {
        includeConfig "${projectDir}/conf/base.config"
        includeConfig "${projectDir}/conf/docker.config"
    }
}

manifest {
    name            = "single-cell-atlas-explorer/pbmc3k-scanpy"
    author          = "Ramanuj Sarkar"
    description     = "Scanpy single-cell RNA-seq analysis of the 10x PBMC3k dataset (QC, normalization, dimensionality reduction, clustering, annotation) with MultiQC reporting"
    version         = "1.0.0"
    mainScript      = "main.nf"
    nextflowVersion = ">=23.10.0"
    doi             = "10.1038/nbt.3820"
}
